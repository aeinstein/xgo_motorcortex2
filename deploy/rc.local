#!/bin/sh -e
# Nach /etc/rc.local (über deploy/rc-local.service). UART im Rohmodus, Treiber laden,
# Display-Daemon starten (FIFO /tmp/lcd0, schreibbar für die Gruppe video).

stty -F /dev/ttyAMA0 115200 cs8 -cstopb -parenb -brkint -imaxbel -opost -onlcr -isig -icanon -iexten -echo -echoe -echok -echoctl -echoke -ixon -ixoff -icrnl -inlcr -igncr -istrip min 0 time 1
modprobe xgo-drv
st7789_server
chgrp video /tmp/lcd0
chmod g+w /tmp/lcd0
# Besitzer-Datei der Emotions-Player (tools/emotion.sh): root-eigen wegen fs.protected_regular
install -m 0664 -g video /dev/null /tmp/lcd0.owner
# Hochgefahren: Emotion "cute"
[ -x /opt/xgonav/tools/emotion.sh ] && /opt/xgonav/tools/emotion.sh play /opt/xgonav/emotions/cute >/dev/null 2>&1 &

exit 0

