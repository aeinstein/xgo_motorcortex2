[Unit]
Description=xgo shutdown-led - beim Herunterfahren des Pi LEDs des Riders blau (Firmware-Patch 06-leds, Aktion 234); ganz zuletzt sendet der Treiber 235 (Pi aus, Reboot-Notifier); Treiber und xgonav setzen beim Start zurück (233)
# Nach rc-local (lädt den Treiber) und xgonav gestartet, also beim Herunterfahren vor beiden gestoppt: der Treiber ist noch da.
After=rc-local.service xgonav.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/sh -c 'echo 234 > /proc/XGORider/action || true'

[Install]
WantedBy=multi-user.target
