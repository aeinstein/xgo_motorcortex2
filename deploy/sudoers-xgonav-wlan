# WLAN-Einrichtung (deploy/xgo-wlan): xgonav (Tasten C+D) und Weboberfläche (web/wlan.php über api.php).
# Den Hotspot öffnet und schließt nur noch xgo-wlan-auto.service (root), deshalb hier kein hotspot/hotspot-off.
# Nach /etc/sudoers.d/xgonav-wlan, Rechte 0440, vorher mit "visudo -cf <datei>" prüfen.
Cmnd_Alias XGO_WLAN = /usr/local/sbin/xgo-wlan connect, /usr/local/sbin/xgo-wlan status, \
                      /usr/local/sbin/xgo-wlan scan
aeinstein ALL=(root) NOPASSWD: XGO_WLAN
www-data ALL=(root) NOPASSWD: XGO_WLAN
