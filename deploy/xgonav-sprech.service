[Unit]
Description=xgonav-sprech - Gegensprechen Browser <-> Rider (nur Modus manual) per WebSocket
After=rc-local.service network.target

[Service]
Type=simple
User=www-data
Group=www-data
# arecord/aplay auf plughw:0,0 (WM8960)
SupplementaryGroups=audio
ExecStart=/usr/bin/php /opt/xgonav/tools/sprech.php
Restart=always
RestartSec=2
# hinter der Bildpipeline; ohne Gespräch schläft der Dienst ohnehin
Nice=10
MemoryMax=64M

[Install]
WantedBy=multi-user.target
