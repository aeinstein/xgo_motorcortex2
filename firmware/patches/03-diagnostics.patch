diff --git a/firmware/src/lift_log.h b/firmware/src/lift_log.h
new file mode 100644
index 0000000..f01b48a
--- /dev/null
+++ b/firmware/src/lift_log.h
@@ -0,0 +1,81 @@
+#pragma once
+// Protokoll des Hebeschutzes (lift_guard.h), das einen Stopp überlebt.
+//
+// Anlass: Sturz am RiderPi 2026-11-24 19:50 bei 0,6 m/s Geradeausfahrt. Die Räder standen binnen ~60 ms, der
+// Zustand blieb 1 bis zum Kippstopp. Der einzige Weg in der Firmware, der so etwas tut, ist der Hebeschutz
+// (Radbefehl 0, Beine an, kein Zustandswechsel). Nachweisen ließ es sich nicht, denn stop() setzt lift::State
+// samt trips zurück, und der Kippstopp kam ~0,1 s später.
+//
+// Hier steht dauerhaft (bis zum Neustart des ESP32), wann der Detektor zuletzt ausgelöst hat, mit welchen
+// Messwerten, wie lange er griff und wie es endete. Dazu der letzte Stopp aus dem Balancieren heraus.
+// Ausgabe: Register 0x19 (main.cpp fillLiftDiag), Konsole !liftguard status.
+//
+// Header-only und ohne Hardware, damit tests/test_lift_log.cpp es am Host prüfen kann.
+#include <cstdint>
+#include <cstdlib>
+
+namespace rider2 { namespace lift {
+
+enum class LogEnd : std::uint8_t { Active = 0, Released = 1, Stopped = 2 };
+
+struct LogSample {
+    std::uint32_t ms = 0;
+    float speed11 = 0, speed21 = 0;     // gefilterte Radgeschwindigkeit wie lift::Input (Registereinheiten)
+    std::int16_t raw11 = 0, raw21 = 0;  // Geschwindigkeitsfeld des Servos, unverändert (21 nicht umgedreht)
+    float forward = 0;                  // gefilterter Fahrbefehl (CommandState::filtered_forward)
+    float pitch = 0;                    // Nick wie für den Regler (ctrlPitch)
+    bool guard_enabled = true;          // !liftguard on/off: griff er, oder hat nur der Detektor angeschlagen
+};
+
+struct Log {
+    std::uint32_t trips = 0;            // Auslösungen seit dem Start des ESP32 (stop() löscht nichts)
+    LogSample trip;                     // Werte im Takt der letzten Auslösung
+    std::uint16_t ticks = 0;            // Dauer der letzten Auslösung in Regeltakten (sättigt)
+    std::int16_t raw_peak = 0;          // betragsgrößtes Geschwindigkeitsfeld eines Servos währenddessen
+    LogEnd end = LogEnd::Active;
+    std::uint8_t end_reason = 0;        // StopReason, wenn end == Stopped
+    bool active = false;
+    // letzter Stopp aus dem Balancieren heraus (anders als last_stop_reason nie von Startup überschrieben)
+    std::uint8_t stop_reason = 0;
+    std::uint32_t stop_ms = 0;
+    std::uint32_t stops = 0;
+};
+
+inline std::int16_t largerMagnitude(std::int16_t a, std::int16_t b) {
+    return std::abs(int(b)) > std::abs(int(a)) ? b : a;
+}
+
+// Einmal je Regeltakt nach dem Detektor, mit dessen Zustand (lift::State::active).
+inline void logTick(Log& l, bool active, const LogSample& s) {
+    if (active && !l.active) {
+        ++l.trips;
+        l.trip = s;
+        l.ticks = 0;
+        l.raw_peak = largerMagnitude(s.raw11, s.raw21);
+        l.end = LogEnd::Active;
+        l.end_reason = 0;
+    }
+    if (active) {
+        if (l.ticks < 65535) ++l.ticks;
+        l.raw_peak = largerMagnitude(l.raw_peak, largerMagnitude(s.raw11, s.raw21));
+    } else if (l.active) {
+        l.end = LogEnd::Released;
+    }
+    l.active = active;
+}
+
+// Aus stop(), bevor lift::State zurückgesetzt wird. driving: der Stopp beendet das Balancieren.
+inline void logStop(Log& l, bool driving, std::uint8_t reason, std::uint32_t ms) {
+    if (l.active) {
+        l.active = false;
+        l.end = LogEnd::Stopped;
+        l.end_reason = reason;
+    }
+    if (driving) {
+        l.stop_reason = reason;
+        l.stop_ms = ms;
+        ++l.stops;
+    }
+}
+
+}}  // namespace rider2::lift
