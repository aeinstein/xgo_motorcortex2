-struct BalanceState { Pid speed=speedPid(), pitch=pitchPid(); };
+struct BalanceState { Pid speed=speedPid(), pitch=pitchPid();
+                      float drive_i=0;   // integral of the speed error while driving, byte path (deg of pitch target)
+};
+// The stock speed PI clamps its integral at 100 (ki 0.00073 -> at most 0.07 deg), so it is effectively P only:
+// pitch target = 0.11 x (target - speed), at most ~3.5 deg at full command. A constant load (slight slope, rolling
+// resistance) then stops the Rider although the full forward command arrives. While driving, a separate integral
+// is added, but only as a floor: it integrates (kDriveMinFrac x target - speed), acts only in the direction of the
+// command (0..kDriveIMax) and is zero again as soon as the Rider rolls faster than kDriveMinFrac of the command
+// (integrating the full error wound up at every start and made the speed swing with ~5 s). A leftover against a
+// reversed command and the integral without a command decay smoothly (no jump).
+constexpr float kDriveKi=0.0003f;    // deg per control call (~3 ms) and unit of speed error
+constexpr float kDriveIMax=3.0f;     // deg
+constexpr float kDriveMinFrac=0.3f;  // floor speed as a fraction of the command
+constexpr float kDriveDecay=0.99f;   // per call without forward command (~0.3 s)
