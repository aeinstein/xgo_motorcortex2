+    // rechts vorwärts (gemessen bis 0,3 m/s, 2026-11-05). Nur Nick zu korrigieren reicht nicht:
+    // bei 80 °/s läuft dann die Rollschätzung um ±2,5° weg und verdirbt die Nickkorrektur.
+    // Ohne Drehung unverändert. Winkel auf ±30° begrenzt (liegend ginge tan gegen unendlich).
+    const float tan_roll = std::tan(clamp(s.roll_deg, -30.0f, 30.0f) * 0.017453292f);
+    const float tan_pitch = std::tan(clamp(s.pitch_deg, -30.0f, 30.0f) * 0.017453292f);
+    const float pitch_gyro = s.gyro_deg_s[1] - s.gyro_bias[1] + yaw_rate * tan_roll;
+    const float roll_gyro = s.gyro_deg_s[0] - s.gyro_bias[0] - yaw_rate * tan_pitch;
     if (std::fabs(s.gyro_pitch_filtered - s.gyro_deg_s[1]) < 1400.0f)
