     const float yaw_rate = s.gyro_deg_s[2] - s.gyro_bias[2];
+    // Patch 0005: Drehung um die Senkrechte aus Nick- und Rollrate herausrechnen. Ist der Sensor
+    // gekippt (RiderPi balanciert mit ~2° Roll und ~1° Nick), sehen die Kippachsen bei einer
+    // Drehung mit Rate gz einen Anteil davon: Nick gx = -tan(roll) * gz, Roll -gy = tan(pitch) * gz.
+    // Ohne Abzug wird das als Kippen integriert (40 °/s -> ~1,5 °/s Scheinnicken, 2-9° Fehler),
