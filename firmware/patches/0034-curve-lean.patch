+// Patch 0034 (Kommentar in rider_leg_imu.h)
+float updateCurveLean(CurveLean &s, bool on, float speed_m_s, float yaw_rate_deg_s, float height, float dt) {
+    if (!(dt > 0.0f && dt <= 0.1f)) return s.target_deg;
+    float want = 0.0f;
+    if (on && std::isfinite(speed_m_s) && std::isfinite(yaw_rate_deg_s)) {
+        const float lateral = speed_m_s * yaw_rate_deg_s * 0.017453292f;
+        want = -std::atan(lateral / kLeanGravity) * 57.29578f;
+        // Beingrenzen: Differenz sin(Roll) * 43 darf keinem Bein mehr als bis kLeanLegMargin vor 0 bzw. 36 nehmen
+        const float room = std::fmin(height, 36.0f - height) - kLeanLegMargin;
+        const float leg_max = room > 0.0f ? std::asin(clamp(room / 43.0f, 0.0f, 1.0f)) * 57.29578f : 0.0f;
+        const float limit = std::fmin(kLeanMaxDeg, leg_max);
+        want = clamp(want, -limit, limit);
+    }
+    const float filtered = s.target_deg + (want - s.target_deg) * (dt < kLeanTau ? dt / kLeanTau : 1.0f);
+    const float step = kLeanRateDegS * dt;
+    s.target_deg = clamp(filtered, s.target_deg - step, s.target_deg + step);
+    if (!std::isfinite(s.target_deg)) s.target_deg = 0.0f;
+    return s.target_deg;
+}
