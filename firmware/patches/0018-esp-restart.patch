         standup_requested=true;standup_phase=false;standup_upright_ticks=0;standup_request_ms=millis();
         result("stand-up requested; starts within 3 s if |pitch|<40");
     }
+    // Patch 0018: Neustart des ESP32 auf Befehl (Aktion 0x3e = 237, Konsole !restart). Anlass: Nach einem
+    // Aktorfehler beim Aufspringen (Zustand 251, RiderPi 2026-11-17) hielt ein Bein fest, erst Aus- und
+    // Einschalten half. Nur wenn er nicht balanciert (sonst fiele er um): Stopp, "Drehmoment aus" noch einmal
+    // an beide Beine (der Stopp davor wiederholt es nicht, wenn schon gestoppt war), Bus leerlaufen lassen,
+    // dann ESP.restart(). Beim Start schickt prepareMotorBus() den Stopp ohnehin erneut. Die Servos selbst
+    // setzt das nicht zurück (kein Stromlos); danach wie nach dem Einschalten: disarmed, Kurs und
+    // Gyro-Nullpunkt neu, LED-Helligkeit und Schalter (0008, 0015) auf Default.
+    void restart() {
+        if(driving){result("restart refused while balancing; stop first (254)");++s.rejected_commands;return;}
+        policy.setMode(rl::Mode::Off);
+        stop(StopReason::Manual,true);
+        bus.pauseFeedback(true);bus.setLegTorque(false);
+        const uint32_t began=millis();
+        do {
+            bus.poll(millis());
+            if(bus.transportIdle())break;
+            delay(1);
+        }while(uint32_t(millis()-began)<100);
+        Serial.println("restarting on command");Serial.flush();
+        delay(20);
+        ESP.restart();
+    }
     bool standupStartOk(const GuardInput& g) const {
         return outputGuard(g)==StopReason::None&&std::fabs(g.pitch)<kStandupMaxPitch&&std::fabs(g.roll)<kStandupMaxRoll;
     }
