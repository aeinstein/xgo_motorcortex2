+#pragma once
+// Fahrbefehl in echten Einheiten (Rahmenweg) mit Sollwertgenerator: Rampe mit Ruckbegrenzung (S-Kurve) statt Tiefpass.
+//
+// Im Original kommen Fahr- und Drehbefehl als Byte (0x30/0x32, 128 = Stillstand, Bereich über 0xa0/0xa1). Hier schreibt
+// der Pi einen Rahmen mit Sollgeschwindigkeit (mm/s), Beschleunigung und Ruck sowie Drehrate (°/s),
+// Drehbeschleunigung und Drehruck. Ohne Geschwindigkeit (Flag bit0) wird die Beschleunigung mit Vorzeichen
+// ausgeführt, ohne Geschwindigkeitsregelung, begrenzt durch v_max (nur Fahren; Drehen braucht immer w).
+// v_max, w_max und der Wächter kommen einmal beim Start von xgonav (0x1b); ohne sie wird 0x1a verworfen.
+//
+// Sollwertgenerator, je Achse (Fahren: v, a, Ruck; Drehen: w, alpha, Drehruck):
+//   Die Soll-Beschleunigung läuft mit höchstens Ruck auf die Wunsch-Beschleunigung zu; die Wunsch-Beschleunigung
+//   ist die größte, die sich mit dem Ruck bis zum Ziel noch auf 0 abbauen lässt: sign(dv)·min(a, sqrt(2·Ruck·|dv|))
+//   (im Takt um den Stufenabbau berichtigt).
+//   Am Ziel rastet der Sollwert ein (a = 0). a = 0 heißt ohne Beschleunigungsgrenze (Sprung), Ruck = 0 ohne
+//   Ruckgrenze (Rampe mit Knicken). Beschleunigungsbetrieb: Ziel ±v_max mit |a|; a = 0 hält das Tempo (Beschleunigung
+//   baut sich mit dem Ruck ab). Ausgegeben werden v/w und die Soll-Beschleunigungen (für die Vorsteuerung des Reglers).
+//   Die Sollwerte ersetzen in updateCommandTargets Tiefpass und 5er-Schritt (filtered_forward/turn = Sollwert).
+//   Start aus der Fahrt: der Generator beginnt beim aktuellen filtered_forward/turn.
+// Krümmungsbetrieb (Flag bit1): Das Feld w trägt die Bahnkrümmung κ in 0,001 1/m statt der Drehrate. Im Takt
+//   w_soll = κ · v_soll · 180/π (aus dem Sollwert des Generators, nicht dem Ist: Kurs = ∫κ·v_soll dt, rauschfrei, am Pi
+//   nachrechenbar; keine Schwelle, w → 0 von selbst). Bahntreue unter den Grenzen: nicht w kappen, sondern die Fahrachse
+//   begrenzen: |v| ≤ w_max/|κ|, a ≤ alpha/|κ|, Ruck ≤ Drehruck/|κ| (alpha/Drehruck 0 = ohne Grenze). Ein neues κ läuft mit
+//   |dκ/dt| ≤ alpha/|v| nach (Klothoide), steht er (v = 0) oder ist alpha 0, springt es. Beim Wechsel in den Betrieb
+//   beginnt κ bei w/v des laufenden Sollwerts (aus dem Stand beim Ziel-κ). Rückwärts gleiches κ: derselbe Kreis
+//   rückwärts (w = κ·v < 0 bei κ > 0). Auch im Beschleunigungsbetrieb und beim Wächter: w folgt κ·v, die Bahn bleibt.
+//   Drehen auf der Stelle geht damit nicht (v = 0 -> w = 0).
+// Kursziel (Flag bit2): Das Feld w trägt einen Drehwinkel Δψ in 0,1°, relativ zum Generatorwinkel bei Empfang; der
+//   Generator führt den Restwinkel (Rest -= w_soll·dt, = Änderung des Kursziels, das genau mit w_soll·dt läuft) und dreht
+//   mit w_max (0x1b), alpha und Drehruck (Rahmen) ohne Überschwingen hin: je Takt nimmt er den Schritt Richtung ±w_max nur,
+//   wenn der Bremsweg danach (mit demselben approach auf 0 vorausgerechnet) noch in den Rest passt, sonst bremst er.
+//   Ohne alpha (0) ist w = sign·min(w_max, |Rest|/dt). Angekommen bei w = 0 und |Rest| < 0,5° (0x1a lesen Flag bit6),
+//   danach w = 0, der Kurs-PID hält das Kursziel, solange Kursziel-Rahmen kommen (auch im Stand, TurnControl::hold). Wechselbit (Flag bit4): Ein Kursziel-Rahmen setzt nur dann ein neues Ziel, wenn
+//   vorher kein Kursziel lief oder bit4 anders ist als im letzten Kursziel-Rahmen; gleiche Rahmen halten nur den Wächter
+//   wach (der Pi schickt sie laufend nach). Das Feld v gilt wie im Geschwindigkeitsbetrieb (Drehen im Fahren = Bogen).
+//   Wächter: v und w mit den Rahmengrenzen auf 0, das Ziel bleibt offen.
+// Strecke mit Halt (Flag bit3, Rahmen 15 Byte): Byte 13 u16 Reststrecke s in echten mm. Jeder Rahmen setzt den Rest
+//   neu auf s (kein Wechselbit: der Pi schickt die Reststrecke aus seiner Odometrie laufend nach). Je Takt sinkt der Rest
+//   um die gemessene Radstrecke (Radtempo × unit_mm × dt, in Fahrtrichtung des Rahmens). Die Fahrachse nimmt den Schritt
+//   Richtung v nur, wenn der Bremsweg danach (mit demselben approach auf 0 vorausgerechnet) noch in den wirksamen Rest
+//   passt, sonst bremst sie. Wirksamer Rest = Rest − Nachlauf; Nachlauf = kDistCoastS × v_ist in mm (was der Rider
+//   nach dem Soll noch fährt; v_ist = Radtempo in Fahrtrichtung, Tiefpass kDistMeasTau, beim Einschalten 0). Kein
+//   Integral seit Beginn: den Rückstand beim Anlauf holt der Rider nie auf. Bei wirksamem Rest ≤ kDistArrive ist
+//   die Strecke erreicht (0x1a lesen Flag bit7), v = 0, Positionshalten wie im Stand. Mit bit1 (Krümmung) zählt die Bogenlänge. Wächter: bremst, Strecke bleibt offen.
+// Absolutes Kursziel (Flag bit5, Rahmen 5 Byte, sonst kein Bit): Wunschkurs ψ_ziel im Kurs der Firmware (Lagefusion, wie
+//   im Strom und in /proc/XGORider/yaw) und w_max für diese Drehung. Bezug ψ_ref ist das Kursziel des Kurs-PID vor dem Takt
+//   (läuft genau mit w_soll·dt, der PID zieht den Ist-Kurs dorthin); je Takt Rest = wrap180(ψ_ziel − ψ_ref), also der
+//   kürzere Weg (genau 180° gegenüber: rechts herum). Drehungen über 180° führt der Pi stückweise nach (≤ 170° voraus).
+//   Jeder Rahmen setzt nur das Ziel; der Generator läuft mit seinem Zustand weiter (kein Wechselbit, kein Neustart):
+//   ein geändertes Ziel oder w_max wird fließend übernommen, ein Ziel hinter dem Bremsweg mit Umkehr ohne Ruckverletzung.
+//   Drehachse wie beim Kursziel (bit2) mit w_max = min(Rahmen, 0x1b; Rahmen 0 = 0x1b), alpha und Drehruck aus 0x1b
+//   (18 Byte); ohne sie wird der Rahmen verworfen. Ein kleineres w_max wird mit alpha abgebaut, nur das w_max aus 0x1b
+//   kappt sofort. Fahrachse auf 0 mit a/Ruck des letzten Rahmens mit Fahrachse (ohne: kWatchdogAccel, ohne Ruck).
+//   Angekommen wie beim Kursziel (w = 0, |Rest| < 0,5°, 0x1a lesen Flag bit5/bit6), danach Halten mit dem Halte-Integral;
+//   erst bei |Rest| > kCourseReopen dreht er wieder (Wackeln des Ziels im Halten bewegt nichts). Wächter wie beim Kursziel.
+// bit1 und bit2 schließen sich aus, bit4 nur mit bit2, bit3 nur mit 15 Byte und nicht mit bit0 oder bit2, bit5 nur allein
+//   mit 5 Byte; unbekannte Bits -> Rahmen verworfen (Zähler rejected_commands).
+// Der zuletzt beschriebene Weg gilt: ein Byte 0x30/0x32, Neutral, Stopp, Aktion oder Armen beenden den Rahmenweg.
+// Wächter: kommt timeout_ms lang kein Rahmen, rampt er v und w mit den Grenzen des letzten Rahmens auf 0
+// (ohne Grenze mit kWatchdogAccel/kWatchdogAlpha), Beschleunigungsbetrieb aus.
+//
+// Register (little-endian):
+//   0x1a schreiben, 13 Byte: 0 u8 Flags (bit0 = ohne Geschwindigkeit, bit1 = Krümmung, bit2 = Kursziel, bit4 =
+//        Wechselbit des Kursziels) | 1 i16 v mm/s | 3 i16 a mm/s² (Vorzeichen nur im Beschleunigungsbetrieb)
+//        | 5 u16 Ruck mm/s³ | 7 i16 w 0,1 °/s, mit bit1 κ 0,001 1/m, mit bit2 Δψ 0,1°
+//        (bit3 = Strecke: 15 Byte, zusätzlich | 13 u16 Reststrecke mm)
+//        | 9 u16 alpha °/s² | 11 u16 Drehruck °/s³
+//   0x1a schreiben, 5 Byte (absolutes Kursziel): 0 u8 Flags = 0x20 | 1 i16 ψ_ziel 0,01° (mod 360 genommen, der Pi
+//        schickt ±180) | 3 u16 w_max 0,1 °/s (0 = w_max aus 0x1b)
+//   0x1b schreiben, 14 oder 18 Byte: 0 u16 v_max | 2 u16 w_max 0,1 °/s | 4 u16 Wächter ms (0 = aus)
+//        | 6 u16 Einheit µm/s je Firmware-Einheit der Radgeschwindigkeit (0 = 1 mm/s; am Rider 3900)
+//        | 8..13 ohne Bedeutung (xgonav schreibt dort ki, i_max, kv; der Regler nimmt eigene Werte, `!velctl`)
+//        | 14 u16 alpha °/s² | 16 u16 Drehruck °/s³ für das absolute Kursziel (0 = ohne Grenze; nur mit 18 Byte, sonst
+//        keine: dann wird bit5 verworfen; ältere Firmware verwirft 18 Byte ganz, also erst Fähigkeit bit4 lesen)
+//   0x1a lesen, 12 Byte: 0 u8 Flags (bit0 Rahmenweg aktiv, bit1 Beschleunigungsbetrieb, bit2 Wächter hat gegriffen,
+//        bit3 Grenzen gesetzt, bit4 Krümmungsbetrieb, bit5 Kursziel läuft, bit6 Kursziel erreicht, bit7 Strecke
+//        erreicht; bit5/bit6 auch fürs absolute Kursziel) | 1 u8 Fähigkeiten (bit0 Krümmung, bit1 Kursziel, bit2 Strecke;
+//        bit3 Strom 0x16 kommt noch; bit4 absolutes Kursziel samt 0x1b mit 18 Byte; die
+//        Pi-Seite schaltet einen Betrieb nur bei gesetztem Bit ein) | 2 i16 v-Soll mm/s | 4 i16 w-Soll 0,1 °/s | 6 u16 v_max | 8 u16 w_max 0,1 °/s
+//        | 10 u16 Wächter ms
+//
+// Header-only und ohne Hardware, damit tests/test_velocity_cmd.cpp es am Host prüfen kann.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace rider2 { namespace velocity {
+
+constexpr std::uint8_t kFrameLen = 13, kFrameLenDist = 15, kFrameLenAbs = 5, kLimitsLen = 14, kLimitsLenAbs = 18, kDiagLen = 12;
+constexpr std::uint8_t kFlagNoSpeed = 1, kFlagKappa = 2, kFlagCourse = 4, kFlagDist = 8, kFlagCourseSeq = 16, kFlagCourseAbs = 32;
+constexpr std::uint8_t kFlagsKnown = kFlagNoSpeed | kFlagKappa | kFlagCourse | kFlagDist | kFlagCourseSeq | kFlagCourseAbs;
+constexpr std::uint8_t kCaps = 1 | 2 | 4 | 16;   // Fähigkeitsbyte 0x1a lesen: bit0 Krümmung, bit1 Kursziel, bit2 Strecke, bit4 absolutes Kursziel
+constexpr float kCourseReopen = 1.0f;        // ° Rest, ab dem das absolute Kursziel nach der Ankunft wieder dreht
+constexpr float kDistArrive = 5.0f;          // mm Reststrecke für „erreicht“
+constexpr float kDistCoastS = 0.25f;         // s, Nachlauf je Radtempo (gefahren: vorwärts 0,23, rückwärts 0,31)
+constexpr float kDistMeasTau = 0.1f;         // s, Tiefpass des Radtempos für den Nachlauf
+constexpr float kCourseArrive = 0.5f;        // ° Restwinkel für „angekommen“
+constexpr int kStopSimMax = 1000;            // Takte der Bremsweg-Vorausschau (bei 4 ms und 360 °/s² höchstens ~240)
+constexpr float kDeg = 57.29578f;            // ° je rad
+constexpr float kKappaMax = 32.767f;         // 1/m, Bereich des i16-Felds
+// Byte-Bereich des alten Wegs (vorher 0xa0/0xa1, jetzt fest): für Positionshalten und LEDs, die noch Bytes lesen
+constexpr float kByteForward = 210.0f, kByteTurn = 300.0f;
+// Wächter ohne Grenze im letzten Rahmen: damit bremst er
+constexpr float kWatchdogAccel = 500.0f, kWatchdogAlpha = 180.0f;   // mm/s², °/s²
+
+struct Limits {
+    float v_max = 0, w_max = 0; std::uint16_t timeout_ms = 0; bool set = false;
+    float unit_mm = 1.0f;   // mm/s je Firmware-Einheit, für atan(a/g)
+    bool abs_set = false; float abs_alpha = 0, abs_jerk = 0;   // absolutes Kursziel (0x1b 18 Byte): °/s², °/s³
+};
+struct Frame {
+    bool has_speed = true;
+    float v = 0, a = 0, jerk = 0;        // mm/s, mm/s², mm/s³
+    float w = 0, alpha = 0, jerk_w = 0;  // °/s, °/s², °/s³
+    bool kappa_mode = false; float kappa = 0;   // Krümmungsbetrieb (bit1): κ in 1/m, w dann 0
+    bool course_mode = false, course_seq = false; float dpsi = 0;   // Kursziel (bit2, Wechselbit bit4): Δψ in °, w dann 0
+    bool dist_mode = false; float dist = 0;   // Strecke (bit3, 15 Byte): Reststrecke in mm
+    bool abs_mode = false; float psi_goal = 0, w_abs = 0;   // absolutes Kursziel (bit5, 5 Byte): ψ_ziel in °, w_max in °/s (0 = 0x1b)
+};
+struct Axis { float x = 0, a = 0; };     // Sollwert und Soll-Beschleunigung einer Achse
+struct State {
+    bool active = false, accel_mode = false, timed_out = false;
+    Frame frame{};
+    std::uint32_t last_rx_us = 0, last_tick_us = 0;
+    bool ticked = false;
+    Axis fwd{}, turn{};                  // mm/s + mm/s², °/s + °/s²
+    float v = 0, w = 0;                  // ausgegebene Sollwerte mm/s, °/s (= fwd.x, turn.x)
+    bool kappa_on = false; float kappa = 0;   // Krümmungsbetrieb läuft, nachgeführtes κ in 1/m
+    bool course_on = false, course_seq = false, course_done = false; float course_rest = 0;   // Kursziel, Rest in °
+    bool course_abs = false; float course_ref = 0;   // absolutes Kursziel läuft (course_on dazu), zuletzt benutztes ψ_ref
+    bool dist_on = false, dist_done = false; float dist_rest = 0, dist_lag = 0, dist_vf = 0;   // Strecke, Rest und Nachlauf in mm, Radtempo gefiltert
+};
+
+inline std::int16_t i16(const std::uint8_t* d) { return std::int16_t(std::uint16_t(d[0] | (d[1] << 8))); }
+inline std::uint16_t u16(const std::uint8_t* d) { return std::uint16_t(d[0] | (d[1] << 8)); }
+inline void put16(std::uint8_t* d, std::uint16_t v) { d[0] = std::uint8_t(v); d[1] = std::uint8_t(v >> 8); }
+inline std::int16_t sat16(float v) {
+    if (!std::isfinite(v)) return 0;
+    return std::int16_t(std::max(-32768.0f, std::min(32767.0f, std::round(v))));
+}
+
+inline bool parseFrame(const std::uint8_t* d, std::uint8_t len, Frame& f) {
+    if (len == kFrameLenAbs) {   // absolutes Kursziel: nur bit5
+        if (d[0] != kFlagCourseAbs) return false;
+        f = Frame{}; f.abs_mode = true;
+        f.psi_goal = i16(d + 1) * 0.01f; f.w_abs = u16(d + 3) * 0.1f;
+        return true;
+    }
+    if (len != kFrameLen && len != kFrameLenDist) return false;
+    if (d[0] & ~kFlagsKnown) return false;   // unbekannte Betriebsart: nicht raten
+    if (d[0] & kFlagCourseAbs) return false;  // bit5 nur mit 5 Byte
+    const bool dist = (d[0] & kFlagDist) != 0;
+    if (dist != (len == kFrameLenDist)) return false;                         // Strecke genau mit 15 Byte
+    if (dist && (d[0] & (kFlagNoSpeed | kFlagCourse))) return false;          // Strecke braucht ein Tempo, kein Kursziel
+    if ((d[0] & kFlagKappa) && (d[0] & kFlagCourse)) return false;           // Krümmung und Kursziel schließen sich aus
+    if ((d[0] & kFlagCourseSeq) && !(d[0] & kFlagCourse)) return false;      // Wechselbit nur mit Kursziel
+    f.has_speed = (d[0] & kFlagNoSpeed) == 0;
+    f.kappa_mode = (d[0] & kFlagKappa) != 0;
+    f.course_mode = (d[0] & kFlagCourse) != 0; f.course_seq = (d[0] & kFlagCourseSeq) != 0;
+    f.v = i16(d + 1); f.a = i16(d + 3); f.jerk = u16(d + 5);
+    f.kappa = 0; f.dpsi = 0; f.w = 0;
+    if (f.kappa_mode) f.kappa = i16(d + 7) * 0.001f;
+    else if (f.course_mode) f.dpsi = i16(d + 7) * 0.1f;
+    else f.w = i16(d + 7) * 0.1f;
+    f.alpha = u16(d + 9); f.jerk_w = u16(d + 11);
+    f.dist_mode = dist; f.dist = dist ? float(u16(d + 13)) : 0.0f;
+    f.abs_mode = false;
+    return true;
+}
+inline bool parseLimits(const std::uint8_t* d, std::uint8_t len, Limits& l) {
+    if (len != kLimitsLen && len != kLimitsLenAbs) return false;
+    l.v_max = u16(d); l.w_max = u16(d + 2) * 0.1f; l.timeout_ms = u16(d + 4); l.set = true;
+    const std::uint16_t unit = u16(d + 6);
+    l.unit_mm = unit ? unit * 0.001f : 1.0f;
+    l.abs_set = len == kLimitsLenAbs;   // jedes 0x1b ist vollständig: 14 Byte nehmen die Grenzen des absoluten Kursziels weg
+    l.abs_alpha = l.abs_set ? float(u16(d + 14)) : 0.0f; l.abs_jerk = l.abs_set ? float(u16(d + 16)) : 0.0f;
+    return true;
+}
+// Winkel auf [−180, 180) (Rest des absoluten Kursziels)
+inline float wrap180(float x) { return x - 360.0f * std::floor((x + 180.0f) / 360.0f); }
+
+// Rahmen annehmen. false = verworfen (Grenzen fehlen).
+inline bool receive(State& s, const Limits& l, const Frame& f_in, std::uint32_t now_us) {
+    if (!l.set) return false;
+    if (f_in.abs_mode && !l.abs_set) return false;   // ohne alpha/Drehruck aus 0x1b (18 Byte) nicht raten
+    Frame f = f_in;
+    if (f.abs_mode) {   // Fahrachse bremst mit a/Ruck des letzten Rahmens mit Fahrachse (ein absoluter trägt sie weiter)
+        f.a = s.active ? std::fabs(s.frame.a) : 0.0f; f.jerk = s.active ? s.frame.jerk : 0.0f;
+    }
+    if (!s.active) { s.v = 0; s.w = 0; s.ticked = false; }
+    s.active = true; s.timed_out = false; s.frame = f; s.last_rx_us = now_us;
+    s.accel_mode = !f.has_speed;
+    if (f.abs_mode) {   // nur das Ziel; der Generator läuft weiter, ein laufendes absolutes Kursziel bleibt (auch erreicht)
+        if (!s.course_on || !s.course_abs) { s.course_on = true; s.course_abs = true; s.course_done = false; s.course_rest = 0; }
+    } else if (!f.course_mode) { s.course_on = false; s.course_abs = false; }
+    else if (!s.course_on || s.course_abs || f.course_seq != s.course_seq) {   // neues Ziel; gleiche Rahmen halten nur den Wächter wach
+        s.course_on = true; s.course_abs = false; s.course_seq = f.course_seq; s.course_rest = f.dpsi; s.course_done = false;
+    }
+    if (f.dist_mode) {   // jeder Rahmen setzt den Rest neu; der Nachlauf läuft weiter (beginnt beim Einschalten bei 0)
+        if (!s.dist_on) { s.dist_lag = 0; s.dist_vf = 0; }
+        s.dist_on = true; s.dist_rest = f.dist; s.dist_done = f.dist - s.dist_lag <= kDistArrive;
+    } else { s.dist_on = false; s.dist_done = false; s.dist_rest = 0; s.dist_lag = 0; s.dist_vf = 0; }
+    return true;
+}
+// Rahmenweg beenden (Byte-Befehl, Neutral, Stopp, Aktion, Armen).
+inline void cancel(State& s) {
+    s.active = false; s.accel_mode = false; s.timed_out = false; s.v = 0; s.w = 0; s.ticked = false;
+    s.fwd = Axis{}; s.turn = Axis{}; s.kappa_on = false; s.kappa = 0;
+    s.course_on = false; s.course_done = false; s.course_rest = 0; s.course_abs = false; s.course_ref = 0;
+    s.dist_on = false; s.dist_done = false; s.dist_rest = 0; s.dist_lag = 0; s.dist_vf = 0;
+}
+
+inline float clampAbs(float x, float m) { return std::max(-m, std::min(m, x)); }
+// kleinere zweier Grenzen, 0 = ohne Grenze
+inline float minLimit(float a, float b) { return a <= 0 ? b : (b <= 0 ? a : std::min(a, b)); }
+
+// Eine Achse einen Schritt dt auf target zu, Beschleunigung ≤ amax, Ruck ≤ jmax (0 = ohne Grenze).
+inline void approach(Axis& s, float target, float amax, float jmax, float dt) {
+    if (amax <= 0) { s.x = target; s.a = 0; return; }   // ohne Grenze: Sprung, auch im ersten Takt
+    if (dt <= 0) return;
+    const float dv = target - s.x;
+    if (jmax <= 0) {
+        const float step = amax * dt;
+        if (std::fabs(dv) <= step) { s.x = target; s.a = 0; }
+        else { s.a = std::copysign(amax, dv); s.x += s.a * dt; }
+        return;
+    }
+    // größte Beschleunigung, die sich mit jmax bis zum Ziel noch auf 0 abbauen lässt. Stetig a²/2j = |dv|; im Takt dt
+    // baut sie sich in Stufen jmax·dt ab und legt dabei a²/2j + a·dt/2 zurück, daraus a (sonst käme er mit Rest-a an)
+    const float jstep = jmax * dt, h = 0.5f * jstep;
+    const float a_des = dv == 0 ? 0.0f : std::copysign(std::min(amax, std::sqrt(h * h + 2.0f * jmax * std::fabs(dv)) - h), dv);
+    s.a += std::max(-jstep, std::min(jstep, a_des - s.a));
+    const float nx = s.x + s.a * dt;
+    if (dv == 0 ? std::fabs(s.a) <= jstep : (target - nx) * dv <= 0) { s.x = target; s.a = 0; }   // am Ziel einrasten
+    else s.x = nx;
+}
+// Beschleunigungsbetrieb ohne Tempoziel: a mit Ruck auf a_cmd, Tempo bis ±vmax (dort einrasten).
+inline void accelerate(Axis& s, float a_cmd, float jmax, float vmax, float dt) {
+    if (dt <= 0) return;
+    if (a_cmd != 0) { approach(s, std::copysign(vmax, a_cmd), std::fabs(a_cmd), jmax, dt); return; }
+    // a = 0: Tempo halten, Beschleunigung mit dem Ruck abbauen
+    if (jmax <= 0) s.a = 0;
+    else { const float jstep = jmax * dt; s.a -= std::max(-jstep, std::min(jstep, s.a)); }
+    s.x = clampAbs(s.x + s.a * dt, vmax);
+}
+
+// Bremsweg einer Achse aus (x, a), mit demselben approach auf 0 vorausgerechnet (Einheit von x mal s).
+inline float stopDistance(Axis ax, float amax, float jmax, float dt) {
+    float d = 0;
+    for (int i = 0; i < kStopSimMax && (ax.x != 0 || ax.a != 0); ++i) { approach(ax, 0, amax, jmax, dt); d += ax.x * dt; }
+    return d;
+}
+// Fahrachse auf Strecke (Kopfkommentar): Schritt Richtung v_target nur, wenn der Bremsweg danach in den Rest (mm) passt.
+inline void approachDist(State& s, const Limits& l, float v_target, float amax, float jmax, float dt) {
+    const float rest = s.dist_rest - s.dist_lag;   // wirksamer Rest: was der Rider nach dem Soll noch fährt, kommt dazu
+    if (rest <= kDistArrive) s.dist_done = true;
+    if (s.dist_done) { approach(s.fwd, 0, amax, jmax, dt); return; }
+    if (dt <= 0) return;
+    Axis go = s.fwd; approach(go, v_target, amax, jmax, dt);
+    const float after = rest - std::fabs(go.x) * dt * l.unit_mm - std::fabs(stopDistance(go, amax, jmax, dt)) * l.unit_mm;
+    if (after >= 0) s.fwd = go;
+    else approach(s.fwd, 0, amax, jmax, dt);
+}
+// Krümmungsbetrieb (Kopfkommentar): Generator nur auf der Fahrachse, w = κ·v_soll. m = m/s je Einheit von v.
+inline void tickKappa(State& s, const Limits& l, std::uint32_t now_us, float dt) {
+    const Frame& f = s.frame;
+    const float m = l.unit_mm * 1e-3f;
+    const float target_k = clampAbs(f.kappa, kKappaMax);
+    if (!s.kappa_on) {   // Übernahme aus der Fahrt: κ aus dem laufenden w/v, sonst springt w
+        const float vm = s.fwd.x * m;
+        s.kappa = std::fabs(vm) > 1e-3f ? clampAbs(s.turn.x / kDeg / vm, kKappaMax) : target_k;
+        s.kappa_on = true;
+    }
+    // κ nachführen: |dκ/dt| ≤ alpha/|v| (Drehbeschleunigung aus der κ-Änderung ≤ alpha)
+    const float vm = std::fabs(s.fwd.x * m), al = f.alpha / kDeg;
+    if (al <= 0 || vm < 1e-6f) s.kappa = target_k;
+    else s.kappa += clampAbs(target_k - s.kappa, al / vm * dt);
+    // Grenzen der Fahrachse aus den Drehgrenzen (größeres von laufendem und Ziel-κ): rad/s je Einheit = |κ|·m
+    const float kk = std::max(std::fabs(s.kappa), std::fabs(target_k)) * m;
+    const float v_lim = kk > 0 ? std::min(l.v_max, l.w_max / kDeg / kk) : l.v_max;
+    const float a_lim = kk > 0 && f.alpha > 0 ? f.alpha / kDeg / kk : 0.0f;
+    const float j_lim = kk > 0 && f.jerk_w > 0 ? f.jerk_w / kDeg / kk : 0.0f;
+    if (l.timeout_ms && std::uint32_t(now_us - s.last_rx_us) > std::uint32_t(l.timeout_ms) * 1000u) {
+        if (!s.timed_out) { s.timed_out = true; s.accel_mode = false; }
+        const float a = std::fabs(f.a) > 0 ? std::fabs(f.a) : kWatchdogAccel;
+        approach(s.fwd, 0, minLimit(a, a_lim), minLimit(f.jerk, j_lim), dt);
+    } else if (s.accel_mode) {
+        const float a = minLimit(std::fabs(f.a), a_lim);
+        accelerate(s.fwd, f.a == 0 ? 0.0f : std::copysign(a, f.a), minLimit(f.jerk, j_lim), v_lim, dt);
+    } else {
+        if (s.dist_on) approachDist(s, l, clampAbs(f.v, v_lim), minLimit(std::fabs(f.a), a_lim), minLimit(f.jerk, j_lim), dt);
+        else approach(s.fwd, clampAbs(f.v, v_lim), minLimit(std::fabs(f.a), a_lim), minLimit(f.jerk, j_lim), dt);
+    }
+    // |v| ≤ w_max/|κ| auch, wenn κ gerade gewachsen ist (Bahn bleibt, w wird nie gekappt)
+    s.fwd.x = clampAbs(s.fwd.x, std::min(l.v_max, std::fabs(s.kappa) * m > 0 ? l.w_max / kDeg / (std::fabs(s.kappa) * m) : l.v_max));
+    s.turn.x = s.kappa * m * s.fwd.x * kDeg;
+    s.turn.a = s.kappa * m * s.fwd.a * kDeg;
+    s.v = s.fwd.x; s.w = s.turn.x;
+}
+
+// Drehachse einen Takt auf den Restwinkel s.course_rest (Kursziel und absolutes Kursziel): Schritt Richtung ±wlim nur,
+// wenn der Bremsweg danach in den Rest passt; ohne alpha w = sign·min(wlim, |Rest|/dt); angekommen: auf 0.
+inline void turnToRest(State& s, float wlim, float alpha, float jw, float dt) {
+    if (dt <= 0) return;
+    if (s.course_done) approach(s.turn, 0, alpha, jw, dt);
+    else if (alpha <= 0) { s.turn.x = std::copysign(std::min(wlim, std::fabs(s.course_rest) / dt), s.course_rest); s.turn.a = 0; }
+    else {
+        const float sg = s.course_rest >= 0 ? 1.0f : -1.0f;
+        Axis go = s.turn; approach(go, sg * wlim, alpha, jw, dt);
+        if ((s.course_rest - go.x * dt - stopDistance(go, alpha, jw, dt)) * sg >= 0) s.turn = go;
+        else approach(s.turn, 0, alpha, jw, dt);
+    }
+}
+// Kursziel (Kopfkommentar): Fahrachse wie im Geschwindigkeitsbetrieb, Drehachse auf den Restwinkel.
+inline void tickCourse(State& s, const Limits& l, std::uint32_t now_us, float dt) {
+    const Frame& f = s.frame;
+    if (l.timeout_ms && std::uint32_t(now_us - s.last_rx_us) > std::uint32_t(l.timeout_ms) * 1000u) {
+        if (!s.timed_out) { s.timed_out = true; s.accel_mode = false; }
+        approach(s.fwd, 0, std::fabs(f.a) > 0 ? std::fabs(f.a) : kWatchdogAccel, f.jerk, dt);
+        approach(s.turn, 0, f.alpha > 0 ? f.alpha : kWatchdogAlpha, f.jerk_w, dt);
+    } else {
+        if (s.accel_mode) accelerate(s.fwd, f.a, f.jerk, l.v_max, dt);
+        else approach(s.fwd, clampAbs(f.v, l.v_max), std::fabs(f.a), f.jerk, dt);
+        turnToRest(s, l.w_max, f.alpha, f.jerk_w, dt);
+    }
+    s.fwd.x = clampAbs(s.fwd.x, l.v_max); s.turn.x = clampAbs(s.turn.x, l.w_max);
+    s.course_rest -= s.turn.x * dt;
+    if (!s.course_done && !s.timed_out && s.turn.x == 0 && s.turn.a == 0 && std::fabs(s.course_rest) < kCourseArrive) s.course_done = true;
+    s.v = s.fwd.x; s.w = s.turn.x;
+}
+// Absolutes Kursziel (Kopfkommentar): Rest je Takt aus ψ_ziel − ψ_ref, Fahrachse auf 0, Drehachse wie beim Kursziel.
+inline void tickCourseAbs(State& s, const Limits& l, std::uint32_t now_us, float dt, float psi_ref) {
+    const Frame& f = s.frame;
+    const bool ref_ok = std::isfinite(psi_ref);
+    if (ref_ok) { s.course_ref = psi_ref; s.course_rest = wrap180(f.psi_goal - psi_ref); }
+    if (s.course_done && std::fabs(s.course_rest) > kCourseReopen) s.course_done = false;   // Ziel deutlich verschoben
+    // steht er schon im Band, ist er angekommen (sonst knabberte er am Rest von Tausendstel Grad)
+    if (ref_ok && !s.timed_out && s.turn.x == 0 && s.turn.a == 0 && std::fabs(s.course_rest) < kCourseArrive) s.course_done = true;
+    const float al = l.abs_alpha, jw = l.abs_jerk;
+    const bool watchdog = l.timeout_ms && std::uint32_t(now_us - s.last_rx_us) > std::uint32_t(l.timeout_ms) * 1000u;
+    if (watchdog && !s.timed_out) { s.timed_out = true; s.accel_mode = false; }
+    approach(s.fwd, 0, std::fabs(f.a) > 0 ? std::fabs(f.a) : kWatchdogAccel, f.jerk, dt);
+    if (watchdog || !ref_ok) approach(s.turn, 0, al > 0 ? al : kWatchdogAlpha, jw, dt);   // ohne Bezug nicht raten: bremsen
+    else turnToRest(s, minLimit(l.w_max, f.w_abs), al, jw, dt);
+    s.fwd.x = clampAbs(s.fwd.x, l.v_max); s.turn.x = clampAbs(s.turn.x, l.w_max);
+    s.course_rest -= s.turn.x * dt;
+    if (!s.course_done && !s.timed_out && ref_ok && s.turn.x == 0 && s.turn.a == 0 && std::fabs(s.course_rest) < kCourseArrive) s.course_done = true;
+    s.v = s.fwd.x; s.w = s.turn.x;
+}
+
+// Je Regeltakt, solange der Rahmenweg aktiv ist: Wächter, Generator, Grenzen. Ergebnis in s.v/s.w und s.fwd/s.turn.
+// v_now/w_now: aktuelle gefilterte Sollwerte der Kaskade, Startwert beim ersten Takt (Übernahme aus der Fahrt).
+// v_meas: gemessenes Radtempo (Firmware-Einheiten) für die Strecke (bit3).
+// psi_ref: Kursziel des Kurs-PID vor diesem Takt (°, abgewickelt wie der Kurs) für das absolute Kursziel (bit5); NaN = keins.
+inline void tick(State& s, const Limits& l, std::uint32_t now_us, float v_now = 0, float w_now = 0, float v_meas = 0,
+                 float psi_ref = NAN) {
+    if (!s.active) return;
+    float dt = 0;
+    if (!s.ticked) {
+        s.fwd = Axis{clampAbs(std::isfinite(v_now) ? v_now : 0.0f, l.v_max), 0};
+        s.turn = Axis{clampAbs(std::isfinite(w_now) ? w_now : 0.0f, l.w_max), 0};
+    } else dt = std::min(0.05f, float(std::uint32_t(now_us - s.last_tick_us)) * 1e-6f);
+    s.last_tick_us = now_us; s.ticked = true;
+    const Frame& f = s.frame;
+    if (s.dist_on && dt > 0 && std::isfinite(v_meas)) {   // gemessene Radstrecke und Nachlauf in Fahrtrichtung des Rahmens
+        const float dir = f.v >= 0 ? 1.0f : -1.0f;
+        s.dist_rest -= v_meas * l.unit_mm * dt * dir;
+        s.dist_vf += (v_meas * dir - s.dist_vf) * (1.0f - std::exp(-dt / kDistMeasTau));
+        s.dist_lag = kDistCoastS * s.dist_vf * l.unit_mm;
+    }
+    if (f.kappa_mode) { tickKappa(s, l, now_us, dt); return; }
+    s.kappa_on = false;
+    if (f.abs_mode) { tickCourseAbs(s, l, now_us, dt, psi_ref); return; }
+    if (f.course_mode) { tickCourse(s, l, now_us, dt); return; }
+    if (l.timeout_ms && std::uint32_t(now_us - s.last_rx_us) > std::uint32_t(l.timeout_ms) * 1000u) {
+        if (!s.timed_out) { s.timed_out = true; s.accel_mode = false; }
+        const float a = std::fabs(f.a) > 0 ? std::fabs(f.a) : kWatchdogAccel;
+        const float al = f.alpha > 0 ? f.alpha : kWatchdogAlpha;
+        approach(s.fwd, 0, a, f.jerk, dt);
+        approach(s.turn, 0, al, f.jerk_w, dt);
+    } else {
+        if (s.accel_mode) accelerate(s.fwd, f.a, f.jerk, l.v_max, dt);
+        else if (s.dist_on) approachDist(s, l, clampAbs(f.v, l.v_max), std::fabs(f.a), f.jerk, dt);
+        else approach(s.fwd, clampAbs(f.v, l.v_max), std::fabs(f.a), f.jerk, dt);
+        approach(s.turn, clampAbs(f.w, l.w_max), f.alpha, f.jerk_w, dt);
+    }
+    // Grenzen können während der Fahrt kleiner werden (neues 0x1b): sofort einhalten
+    s.fwd.x = clampAbs(s.fwd.x, l.v_max); s.turn.x = clampAbs(s.turn.x, l.w_max);
+    s.v = s.fwd.x; s.w = s.turn.x;
+}
+
+// Sollwert als Byte des alten Wegs (128 ± 127,5 über den festen Bereich), für Positionshalten und LEDs.
+inline std::uint8_t toByte(float value, float range) {
+    const float b = 128.0f + value / range * 127.5f;
+    return std::uint8_t(std::max(0.0f, std::min(255.0f, std::round(b))));
+}
+
+inline void fillDiag(std::uint8_t* d, const State& s, const Limits& l) {
+    d[0] = std::uint8_t((s.active ? 1 : 0) | (s.accel_mode ? 2 : 0) | (s.timed_out ? 4 : 0) | (l.set ? 8 : 0)
+                        | (s.active && s.kappa_on ? 16 : 0) | (s.active && s.course_on ? 32 : 0)
+                        | (s.active && s.course_on && s.course_done ? 64 : 0) | (s.active && s.dist_on && s.dist_done ? 128 : 0));
+    d[1] = kCaps;
+    put16(d + 2, std::uint16_t(sat16(s.v))); put16(d + 4, std::uint16_t(sat16(s.w * 10.0f)));
+    put16(d + 6, std::uint16_t(std::min(65535.0f, l.v_max))); put16(d + 8, std::uint16_t(std::min(65535.0f, l.w_max * 10.0f)));
+    put16(d + 10, l.timeout_ms);
+}
