+++ b/firmware/src/control/rider_motion.h
@@ -35,7 +35,23 @@ void updatePositionHold(HoldState &, std::uint32_t now_ms,
                         float pitch_deg, bool protection=true,
                         bool allow_turn=false, float gain=1350.0f);
 
-struct BalanceState { Pid speed=speedPid(), pitch=pitchPid(); };
+// Patch 0015: drive_i = integral of the speed error while driving (degrees of pitch target).
+struct BalanceState { Pid speed=speedPid(), pitch=pitchPid(); float drive_i=0; };
+// Patch 0015: the stock speed PI clamps its integral at 100 (ki 0.00073 -> at most 0.07 deg),
+// so it is effectively P only: pitch target = 0.11 x (target - speed), at most ~3.5 deg at full
+// command. A constant load (slight slope, rolling resistance) then stops the Rider although the
+// full forward command arrives (RiderPi 2026-11-10: speed 0 at forward 32, pitch target 3.6 deg).
+// While driving, a separate integral is added, but only as a floor: it integrates
+// (kDriveMinFrac x target - speed), acts only in the direction of the command (0..kDriveIMax)
+// and is therefore zero again as soon as the Rider rolls faster than kDriveMinFrac of the
+// command. The first version integrated the full speed error; RiderPi 2026-11-10: wound up
+// during every start, then speed swung 0.51 -> 0.09 -> 0.38 -> 0.16 m/s (period ~5 s) at a
+// constant command and settled at half the speed without it. A leftover against a reversed
+// command and the integral without a command decay smoothly (no jump).
+constexpr float kDriveKi=0.0003f;    // deg per control call (~3 ms) and unit of speed error
+constexpr float kDriveIMax=3.0f;     // deg
+constexpr float kDriveMinFrac=0.3f;  // floor speed as a fraction of the command
+constexpr float kDriveDecay=0.99f;   // per call without forward command (~0.3 s)
 struct Wheels { std::int16_t id11=0, id21=0; };
 float wheelDistance(std::int32_t id11_encoder, std::int32_t second_encoder);
 // 0x400d582c numeric portion. Set forward_target from the PREVIOUS cycle's
@@ -44,7 +60,8 @@ float wheelDistance(std::int32_t id11_encoder, std::int32_t second_encoder);
 float updateBalance(BalanceState &, float forward_target,
                     float speed11, float speed21, float pitch_deg,
                     float pitch_bias, float pitch_rate_rad_s,
-                    float filtered_height, bool holding, Wheels &);
+                    float filtered_height, bool holding, Wheels &,
+                    bool drive_integral=false);   // Patch 0015
 // 0x400d4fd4; called before the command filters are advanced.
 void addWheelSpeedCorrection(Wheels &, float filtered_forward,
                              float filtered_turn, float speed11, float speed21);
