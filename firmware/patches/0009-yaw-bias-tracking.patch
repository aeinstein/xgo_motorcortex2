                std::uint32_t now_us, std::uint32_t uptime_ms,
                std::uint8_t robot_mode);
 
+// Patch 0009: Gyro-z-Nullpunkt laufend nachführen. R-1.1.6 misst ihn nur einmal 0,5 s nach dem
+// Start und integriert die Gier erst ab 2 °/s; erwärmt sich der Sensor, liegt der Nullpunkt
+// daneben (RiderPi 2026-11-05: 0,48 °/s, nach 75 s Drehprobe 31° Kursfehler). Referenz je
+// IMU-Probe: Wheels = balanciert, Drehung aus der Encoder-Differenz; Still = liegt/steht still
+// (Drehung 0, nur wenn Gyro und Beschleunigung ruhig sind); None = keine (Fenster verwerfen).
+enum class YawReference : std::uint8_t { None = 0, Wheels = 1, Still = 2 };
+struct YawBiasTracker {
+    double gyro_deg = 0, window_s = 0;   // Integral (gz - Nullpunkt) im laufenden Fenster, ohne Totband
+    std::int32_t e11 = 0, e21 = 0;       // Encoder bei Fensterbeginn
+    float accel_min[3]{}, accel_max[3]{};
+    std::uint32_t last_us = 0;
+    YawReference ref = YawReference::None;
+    bool open = false;
+    std::uint16_t updates = 0;           // Zahl der Nachführungen (Register 0x0f)
+    float last_error_deg_s = 0;          // letzte Abweichung Gyro - Referenz (Register 0x0f)
+    float boot_bias = 0;                 // Nullpunkt der Startkalibrierung (Register 0x0f)
+    bool boot_seen = false;
+};
+constexpr float kYawDeadbandDegS = 0.3f;        // Original 2 °/s
+constexpr double kWheelYawDegPerTick = 0.1170;  // (pi*0,060 m/1024)/0,090 m in Grad, am Rider gegen IMU gemessen
+// Nach updateImu je Probe aufrufen; encoder11/21 vorwärts positiv (11 = links), Drehung links +.
+void trackYawBias(ImuState &state, YawBiasTracker &tracker, YawReference ref,
+                  std::int32_t encoder11, std::int32_t encoder21, std::uint32_t now_us);
+
 }} // namespace rider::control
