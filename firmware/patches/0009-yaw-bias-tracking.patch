 }
+
+// Patch 0009 (Kommentar in rider_leg_imu.h). Fenster von 1 s: mittlere Abweichung Gyro - Referenz,
+// Nullpunkt mit Zeitkonstante 5 s (Still) bzw. 15 s (Räder) nachziehen. Schnelle Drehungen
+// (Räder rutschen) und unruhige Lage (getragen) verwerfen das Fenster.
+void trackYawBias(ImuState &s, YawBiasTracker &t, YawReference ref,
+                  std::int32_t e11, std::int32_t e21, std::uint32_t now_us) {
+    const double dt = double(std::uint32_t(now_us - t.last_us)) * 0.000001;
+    t.last_us = now_us;
+    if (!s.calibrated) t.boot_seen = false;
+    else if (!t.boot_seen) { t.boot_seen = true; t.boot_bias = s.gyro_bias[2]; }
+    const float rate = s.gyro_deg_s[2] - s.gyro_bias[2];
+    bool calm = s.calibrated && ref != YawReference::None && std::fabs(rate) < 6.0f && dt > 0.0 && dt < 0.02;
+    // Still: nur kleine Restdrehung zulassen (Nullpunktfehler durch Erwärmung ~0,5 °/s); getragen
+    // oder bewegt erkennt die Beschleunigungsspanne im Fenster (0,5 m/s^2 ~ 3° Kippen).
+    if (calm && ref == YawReference::Still) calm = std::fabs(rate) < 1.5f;
+    if (!calm || !t.open || ref != t.ref) {
+        t.open = calm;
+        t.ref = ref;
+        t.gyro_deg = t.window_s = 0;
+        t.e11 = e11; t.e21 = e21;
+        for (int n = 0; n < 3; ++n) t.accel_min[n] = t.accel_max[n] = s.acceleration[n];
+        return;
+    }
+    t.gyro_deg += double(rate) * dt;
+    t.window_s += dt;
+    for (int n = 0; n < 3; ++n) {
+        if (s.acceleration[n] < t.accel_min[n]) t.accel_min[n] = s.acceleration[n];
+        if (s.acceleration[n] > t.accel_max[n]) t.accel_max[n] = s.acceleration[n];
+    }
+    if (t.window_s < 1.0) return;
+    double ref_deg = 0, tau_s = 5.0;
+    bool use = true;
+    if (ref == YawReference::Wheels) {
+        const std::int32_t d11 = std::int32_t(std::uint32_t(e11) - std::uint32_t(t.e11));
+        const std::int32_t d21 = std::int32_t(std::uint32_t(e21) - std::uint32_t(t.e21));
+        ref_deg = double(d21 - d11) * kWheelYawDegPerTick;
+        tau_s = 15.0;
+        use = std::fabs(ref_deg) < 5.0 * t.window_s;
+    } else {
+        for (int n = 0; n < 3; ++n) use = use && t.accel_max[n] - t.accel_min[n] < 0.5f;
+    }
+    if (use) {
+        const double err = (t.gyro_deg - ref_deg) / t.window_s;
+        const double step = (err > 2.0 ? 2.0 : err < -2.0 ? -2.0 : err) * t.window_s / tau_s;
+        s.gyro_bias[2] = float(double(s.gyro_bias[2]) + step);
+        t.last_error_deg_s = float(err);
+        ++t.updates;
+    }
+    t.gyro_deg = t.window_s = 0;
+    t.e11 = e11; t.e21 = e21;
+    for (int n = 0; n < 3; ++n) t.accel_min[n] = t.accel_max[n] = s.acceleration[n];
+}
 }} // namespace rider::control
