+// Patch 0032: Drehratenregler für den Rahmenweg (velocity_cmd.h, Stufe 4 von ARBEITSPLAN.md Punkt 4).
+// Das Original erhöht das Kursziel je Regeltakt um filtered_turn × 0,005, bei 4 ms Takt also um 1,25 × w je Sekunde
+// und abhängig vom Takt; daneben die Vorsteuerung −turn × 0,5 auf die Räder. Mit on läuft das Kursziel genau mit
+// w_soll · dt (w_soll = gerampter Sollwert aus 0030): P auf den Kurs wirkt dann als Integral auf die Drehrate, D auf
+// den Kurs als P auf die Drehrate, die Drehrate stimmt im Mittel, und bei w = 0 hält er den Kurs wie bisher.
+// kp/kd/ff zur Laufzeit (Konsole !turnctl). Aus = Original bitgleich.
+struct TurnControl {
+    bool on=false;
+    float dt=0.004f;        // s seit dem letzten Regeltakt
+    float kp=3.0f;          // Kurs-PID wie headingPid
+    float kd=0.5f;
+    float ff_gain=0.5f;     // Radeinheiten je °/s Soll-Drehrate (Original 0,5)
+};
