+#pragma once
+// Bausteine des neuen BLE-Dienstes, ohne Arduino (Host-Test firmware/tests/test_ble_tunnel.cpp).
+//
+// Tunnel BLE <-> Pi: Die Characteristic PI reicht Bytes unverändert durch.
+//   ESP32 -> Pi: Rahmen (buildFrame) Typ 0x15, Register 0x17, Nutzlast = Kennung + höchstens 23 Byte
+//   Pi -> ESP32: Schreibbefehl auf Register 0x17, Nutzlast ebenso (nur Kennung 0)
+//   Kennung 0 = Daten, 1 = BLE verbunden, 2 = BLE getrennt (1/2 ohne Daten, nur ESP32 -> Pi)
+// Register 0x18: IPv4 des Pi, 4 Byte. Der Pi schreibt sie alle paar Sekunden (nur über Aux angenommen),
+// lesbar von überall; kommt kPiIpTimeoutMs lang nichts, gilt 0.0.0.0.
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include "command_protocol.h"
+
+namespace rider2 { namespace tunnel {
+
+constexpr std::uint8_t kType = 0x15, kReg = 0x17, kIpReg = 0x18;
+constexpr std::uint8_t kData = 0, kConnected = 1, kDisconnected = 2;
+constexpr std::size_t kMaxData = 23;                 // + Kennung = 24 Byte Nutzlast (Grenze des Parsers)
+constexpr std::size_t kMaxFrame = kMaxData + 1 + 8;
+constexpr std::uint32_t kPiIpTimeoutMs = 10000;
+
+// Rahmen ESP32 -> Pi. Rückgabe Länge, 0 bei Fehler.
+inline std::size_t buildFrame(std::uint8_t kind, const std::uint8_t* data, std::size_t n,
+                              std::uint8_t* out, std::size_t cap) {
+    if (n > kMaxData || (n && !data)) return 0;
+    std::uint8_t payload[kMaxData + 1];
+    payload[0] = kind;
+    if (n) std::memcpy(payload + 1, data, n);
+    return protocol::buildFrame(kType, kReg, payload, n + 1, out, cap);
+}
+
+// Bytepuffer für die Ausgabe über BLE (Konsole, Tunnel). Nur ein Task schreibt und liest (loop()).
+// Passt etwas nicht mehr hinein, wird der Rest verworfen und gezählt.
+class ByteRing {
+public:
+    void attach(std::uint8_t* storage, std::size_t capacity) { buf_ = storage; cap_ = capacity; clear(); }
+    void clear() { head_ = used_ = 0; }
+    std::size_t size() const { return used_; }
+    std::size_t space() const { return cap_ - used_; }
+    std::uint32_t dropped() const { return dropped_; }
+    std::size_t push(const std::uint8_t* bytes, std::size_t n) {
+        if (!buf_ || !bytes) return 0;
+        const std::size_t take = n < space() ? n : space();
+        for (std::size_t i = 0; i < take; ++i) buf_[(head_ + used_ + i) % cap_] = bytes[i];
+        used_ += take;
+        dropped_ += std::uint32_t(n - take);
+        return take;
+    }
+    std::size_t pop(std::uint8_t* out, std::size_t max) {
+        if (!buf_ || !out) return 0;
+        const std::size_t take = max < used_ ? max : used_;
+        for (std::size_t i = 0; i < take; ++i) out[i] = buf_[(head_ + i) % cap_];
+        head_ = (head_ + take) % (cap_ ? cap_ : 1);
+        used_ -= take;
+        return take;
+    }
+private:
+    std::uint8_t* buf_ = nullptr;
+    std::size_t cap_ = 0, head_ = 0, used_ = 0;
+    std::uint32_t dropped_ = 0;
+};
+
+// Vom Pi gemeldete IPv4. set()/expire() liefern true, wenn sich der sichtbare Wert geändert hat.
+struct PiIp {
+    std::uint8_t ip[4] = {0, 0, 0, 0};
+    std::uint32_t last_ms = 0;
+    bool known = false;
+    bool set(const std::uint8_t* value, std::uint32_t now) {
+        const bool changed = std::memcmp(ip, value, 4) != 0;
+        std::memcpy(ip, value, 4);
+        last_ms = now;
+        known = true;
+        return changed;
+    }
+    bool expire(std::uint32_t now) {
+        if (!known || std::uint32_t(now - last_ms) <= kPiIpTimeoutMs) return false;
+        known = false;
+        const std::uint8_t zero[4] = {0, 0, 0, 0};
+        const bool changed = std::memcmp(ip, zero, 4) != 0;
+        std::memset(ip, 0, 4);
+        return changed;
+    }
+};
+
+// Sammelt Bytes zu Zeilen (Konsole über BLE). feed() liefert true, wenn eine Zeile fertig ist;
+// sie steht dann nullterminiert in text(). Zu lange Zeilen werden bis zum Zeilenende verworfen.
+template <std::size_t N>
+class LineBuffer {
+public:
+    bool feed(std::uint8_t byte) {
+        if (byte == '\r' || byte == '\n') {
+            const bool ok = used_ > 0 && !overflow_;
+            if (ok) line_[used_] = 0;       // eine leere Zeile lässt die letzte stehen
+            used_ = 0;
+            overflow_ = false;
+            return ok;
+        }
+        if (used_ < N - 1) line_[used_++] = char(byte); else overflow_ = true;
+        return false;
+    }
+    void reset() { used_ = 0; overflow_ = false; }
+    const char* text() const { return line_; }
+private:
+    char line_[N] = {};
+    std::size_t used_ = 0;
+    bool overflow_ = false;
+};
+
+} }
