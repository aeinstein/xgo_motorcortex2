diff --git a/firmware/src/ble_transport.h b/firmware/src/ble_transport.h
index 4ff35f0..175eff1 100644
--- a/firmware/src/ble_transport.h
+++ b/firmware/src/ble_transport.h
@@ -2,13 +2,25 @@
 #include <cstddef>
 #include <cstdint>
 namespace rider2 {
-// Must be called outside the time-critical control loop. BLE callback only
-// enqueues RX bytes; all parser, motion and flash operations run in caller task.
+// eigener BLE-Dienst (ersetzt fff0/fff1/fff2 der Hersteller-App). Ein Service, vier
+// Characteristics (UUIDs in ble_transport.cpp und docs/ble.md):
+//   Cmd  Write/Notify  Binärrahmen wie am Pi-Kanal, Antworten sofort per Notify
+//   Con  Write/Notify  Textkonsole: Zeilen "!befehl\n" hinein, Text heraus
+//   Pi   Write/Notify  Tunnel zum Pi (pi_tunnel.h), Bytes unverändert
+//   Ip   Read/Notify   IPv4 des Pi, 4 Byte
+// Kein Pairing, kein Bonding, keine Flash-Zugriffe. Die BLE-Callbacks legen nur Bytes in Schlangen;
+// gelesen, geparst und gesendet wird im Task des Aufrufers (loop()).
+enum class BleChannel : uint8_t { Cmd = 0, Con = 1, Pi = 2 };
+// Must be called outside the time-critical control loop.
 bool beginBle(const char *name);
-size_t readBle(uint8_t *out, size_t capacity);
+size_t readBle(BleChannel channel, uint8_t *out, size_t capacity);
+// Sofort senden (Antworten auf Cmd).
 bool notifyBle(const uint8_t *bytes, size_t length);
+// In den Ausgabepuffer von Con oder Pi legen; pollBle() sendet stückweise. Ohne Verbindung verworfen.
+void queueBle(BleChannel channel, const uint8_t *bytes, size_t length);
+void setBleIp(const uint8_t ip[4]);
 bool bleConnected();
 uint32_t bleDroppedBytes();
-// Call from application task to restart advertising after a disconnect.
-void pollBle();
+// Call from application task: restart advertising after a disconnect, flush Con/Pi output.
+void pollBle(uint32_t now_ms);
 }
