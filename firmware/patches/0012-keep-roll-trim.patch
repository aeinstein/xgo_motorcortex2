diff --git a/firmware/src/control/rider_leg_imu.cpp b/firmware/src/control/rider_leg_imu.cpp
index 136c9ee..c127467 100644
--- a/firmware/src/control/rider_leg_imu.cpp
+++ b/firmware/src/control/rider_leg_imu.cpp
@@ -29,10 +29,15 @@ void updateLegTargets(LegState &s, float height, float command_roll_deg,
                       bool leveling, float roll_pid_increment,
                       std::uint16_t zero_a, std::uint16_t zero_b) {
     // 0x400d4514; float stores are retained at original rounding boundaries.
+    // Patch 0012: Original klang das Ziel nach dem Nivellieren wieder auf den Rollbefehl ab; gerade blieb
+    // der Rider nur, solange die Beinservos in ihrer Totzone standen. Jede Höhenänderung bewegte beide
+    // Servos, und er stand wieder schief (RiderPi 2026-11-07: ~2°). Jetzt bleibt die gefundene Differenz
+    // als Trimm stehen. Ohne Nivellieren ist roll_trim_deg 0 und das Ergebnis bitgleich zum Original.
     if (leveling) s.roll_target_deg += roll_pid_increment;
     else s.roll_target_deg = float(double(s.roll_target_deg) * 0.95 +
-                                  double(command_roll_deg) * 0.050000000000000044);
+                                  double(command_roll_deg + s.roll_trim_deg) * 0.050000000000000044);
     s.roll_target_deg = clamp(s.roll_target_deg, -20.0f, 20.0f);
+    if (leveling) s.roll_trim_deg = clamp(s.roll_target_deg - command_roll_deg, -10.0f, 10.0f);
     const double difference = std::sin(double(s.roll_target_deg) / 57.3) * 43.0;
     const float a = float(double(height) + difference);
     const float b = float(double(height) - difference);
