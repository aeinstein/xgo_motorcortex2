index 0000000..7491bab
--- /dev/null
+++ b/firmware/src/imu_stream.h
@@ -0,0 +1,93 @@
+#pragma once
+// Patch 0014: IMU- und Raddaten als Datenstrom an den Pi, statt sie per Leseanfrage abzufragen.
+// Einschalten: Schreibbefehl auf Register 0x11, 1 Byte = Rate in Hz (0 = aus, höchstens 250 Hz).
+// Ausgewählt wird nach der Messzeit, nicht nach Probenzahl: Die IMU wird am RiderPi nur etwa alle
+// 3 ms gelesen (gemessen 2026-11-08, nicht 2 ms wie kImuPeriodUs), die Abstände springen daher
+// um eine Abtastung (bei 100 Hz 9/12 ms), im Mittel stimmt die Rate. Nach Neustart aus.
+// Paket im üblichen Rahmen (buildFrame), Typ 0x14 (Antworten haben 0x12), Register 0x11,
+// 26 Byte Nutzdaten little endian:
+//   0 u16 seq (läuft über; eine Lücke heißt verworfenes Paket)
+//   2 u32 t_us  micros() der IMU-Lesung
+//   6/10/14 float Roll, Nick, Kurs (Grad, wie 0x0d)
+//   18/22 s32 Ticks Rad 11 / Rad 21 (wie 0x0c/0x0d)
+// Die Regelung legt Proben nur in den Ring (ein Erzeuger, ein Verbraucher, ohne Sperre); loop()
+// sendet und verwirft, wenn der UART-Puffer voll ist. Senden blockiert die Regelung damit nie.
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include "command_protocol.h"
+
+namespace rider2 { namespace imustream {
+
+constexpr std::uint8_t kReg = 0x11, kType = 0x14;
+constexpr std::size_t kPayload = 26, kFrame = kPayload + 8;
+constexpr std::uint32_t kIdleOffMs = 5000;   // Strom aus, wenn der Pi so lange nichts schickt
+
+// Rate in Hz -> Sollabstand in µs (0 = aus), höchstens 250 Hz.
+inline std::uint32_t periodForHz(std::uint8_t hz) {
+    if (!hz) return 0;
+    return 1000000u / (hz > 250 ? 250u : hz);
+}
+
+struct Sample {
+    std::uint16_t seq = 0;
+    std::uint32_t t_us = 0;
+    float roll = 0, pitch = 0, yaw = 0;
+    std::int32_t w11 = 0, w21 = 0;
+};
+
+// Sagt je IMU-Probe (Messzeit t_us), ob sie gesendet werden soll; seq zählt jede fällige Probe,
+// auch wenn sie nicht gesendet werden kann (ungültig, Ring voll). Liegt die Zeit weit zurück
+// (Pause, Neustart des Stroms), wird neu aufgesetzt statt nachzuholen.
+struct Producer {
+    bool on = false;
+    std::uint32_t next_us = 0;
+    std::uint16_t seq = 0;
+    bool due(std::uint32_t period_us, std::uint32_t t_us) {
+        if (!period_us) { on = false; return false; }
+        if (!on) { on = true; next_us = t_us; }
+        if (std::int32_t(t_us - next_us) < 0) return false;
+        next_us += period_us;
+        if (std::int32_t(t_us - next_us) >= 0) next_us = t_us + period_us;
+        ++seq;
+        return true;
+    }
+};
+
+template <std::size_t N>
+class Ring {
+    static_assert((N & (N - 1)) == 0, "N muss eine Zweierpotenz sein");
+public:
+    bool push(const Sample& s) {
+        const std::uint32_t h = head_.load(std::memory_order_relaxed);
+        if (h - tail_.load(std::memory_order_acquire) >= N) return false;   // voll: verwerfen
+        buf_[h % N] = s;
+        head_.store(h + 1, std::memory_order_release);
+        return true;
+    }
+    bool pop(Sample& s) {
+        const std::uint32_t t = tail_.load(std::memory_order_relaxed);
+        if (t == head_.load(std::memory_order_acquire)) return false;
+        s = buf_[t % N];
+        tail_.store(t + 1, std::memory_order_release);
+        return true;
+    }
+private:
+    Sample buf_[N];
+    std::atomic<std::uint32_t> head_{0}, tail_{0};
+};
+
+inline void putU32(std::uint8_t* p, std::uint32_t v) { for (int i = 0; i < 4; ++i) p[i] = std::uint8_t(v >> (8 * i)); }
+inline void putF(std::uint8_t* p, float v) { std::uint32_t b; std::memcpy(&b, &v, 4); putU32(p, b); }
+
+inline std::size_t buildPacket(const Sample& s, std::uint8_t* out, std::size_t cap) {
+    std::uint8_t d[kPayload];
+    d[0] = std::uint8_t(s.seq); d[1] = std::uint8_t(s.seq >> 8);
+    putU32(d + 2, s.t_us);
+    putF(d + 6, s.roll); putF(d + 10, s.pitch); putF(d + 14, s.yaw);
+    putU32(d + 18, std::uint32_t(s.w11)); putU32(d + 22, std::uint32_t(s.w21));
+    return protocol::buildFrame(kType, kReg, d, kPayload, out, cap);
+}
+
+}} // namespace rider2::imustream
