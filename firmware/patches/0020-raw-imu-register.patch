         // Patch 0019: bit4..7 = verworfene Fenster der Startkalibrierung (bewegt), höchstens 15
         d[30]=uint8_t((m.diag_accel_frozen?1:0)|(m.calibrated?2:0)|((m.calibration_tries<15?m.calibration_tries:15)<<4));d[31]=m.diag_samples;
     }
+    // Patch 0020: Register 0x15, 32 Byte little endian, Rohwerte der IMU zum Bestimmen des Sensormodells
+    // (Nullpunkte, Übersprechen, Bewegungsanteile im Beschleunigungssensor). Laufende Summen über alle Proben
+    // der Regelschleife (~300 Hz), sie laufen über: aus zwei Lesungen ergibt (Differenz der Summe) /
+    // (Differenz des Zählers) das Mittel dazwischen, unabhängig davon, wie oft gelesen wird.
+    // 0 u16 Probenzähler | 2 u16 Messzeit der letzten Probe (micros() >> 6, 64 µs je Schritt) |
+    // 4 3 x u32 Summe Beschleunigung x, y, z (Zählwerte, 19,6/32768 m/s^2; Achsen wie ImuState::acceleration) |
+    // 16 3 x u32 Summe Kreisel Roll, Nick, Gier (Zählwerte, 2000/32768 °/s; Achsen wie ImuState::gyro_deg_s,
+    // ohne Nullpunktabzug) | 28 i16 Ticks Rad 11 (untere 16 Bit) | 30 i16 Ticks Rad 21
+    void fillRawDiag(uint8_t* d) {
+        auto put16=[&](int at,uint16_t v){d[at]=uint8_t(v);d[at+1]=uint8_t(v>>8);};
+        auto put32=[&](int at,uint32_t v){for(int i=0;i<4;++i)d[at+i]=uint8_t(v>>(8*i));};
+        const auto& m=s.imu;
+        put16(0,m.raw_samples);put16(2,uint16_t(m.raw_us>>6));
+        for(int n=0;n<3;++n){put32(4+4*n,m.raw_accel_sum[n]);put32(16+4*n,m.raw_gyro_sum[n]);}
+        put16(28,uint16_t(bus.sample(11).encoder_ticks));put16(30,uint16_t(bus.sample(21).encoder_ticks));
+    }
