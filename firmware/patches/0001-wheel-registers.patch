@@ -15,6 +15,8 @@ uint8_t readLength(uint8_t reg) {
     case 0xb2:return 16;
     case 0x07:return 10;
     case 0x0b:return 16;
+    case 0x0c:return 16;
+    case 0x0d:return 24;
     case 0x62: case 0x63: case 0x64:return 4;
     case 0x65:return 24;
     case 0x66: case 0x67: case 0x68:return 2;
@@ -25,6 +27,9 @@ void putFloat(uint8_t *out, float value) {
     uint32_t bits;std::memcpy(&bits,&value,4);
     for (unsigned i=0;i<4;++i) out[i]=uint8_t(bits>>(i*8));
 }
+void putI32(uint8_t *out, uint32_t value) {
+    for (unsigned i=0;i<4;++i) out[i]=uint8_t(value>>(i*8));
+}
 void putAngle(uint8_t *out, float value) {
     // Firmware trunc.s then sext16. Nonfinite inputs have no valid wire angle.
     int32_t v=0;
@@ -146,6 +151,13 @@ size_t buildReadResponse(const CommandEvent &r,const Telemetry &t,uint8_t *out,s
         }break;
     case 0x07:std::memcpy(data,t.version,10);break;
     case 0x0b:for(unsigned i=0;i<4;++i)putFloat(data+4*i,t.odometry[i]);break;
+    case 0x0c:
+        putI32(data,uint32_t(t.wheel11_ticks));putI32(data+4,uint32_t(t.wheel21_ticks));
+        putI32(data+8,uint32_t(t.wheel11_pos));putI32(data+12,uint32_t(t.wheel21_pos));break;
+    case 0x0d:  // one snapshot: attitude + wheel ticks + timestamp
+        putFloat(data,t.roll_deg);putFloat(data+4,t.pitch_deg);putFloat(data+8,t.yaw_deg);
+        putI32(data+12,uint32_t(t.wheel11_ticks));putI32(data+16,uint32_t(t.wheel21_ticks));
+        putI32(data+20,t.t_ms);break;
     case 0x62:putFloat(data,t.roll_deg);break;
     case 0x63:putFloat(data,t.pitch_deg);break;
     case 0x64:putFloat(data,t.yaw_deg);break;
