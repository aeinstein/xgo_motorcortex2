diff --git a/firmware/src/command_protocol.cpp b/firmware/src/command_protocol.cpp
index 660065a..0de653c 100644
--- a/firmware/src/command_protocol.cpp
+++ b/firmware/src/command_protocol.cpp
@@ -15,6 +15,8 @@ uint8_t readLength(uint8_t reg) {
     case 0xb2:return 16;
     case 0x07:return 10;
     case 0x0b:return 16;
+    case 0x0c:return 16;
+    case 0x0d:return 24;
     case 0x62: case 0x63: case 0x64:return 4;
     case 0x65:return 24;
     case 0x66: case 0x67: case 0x68:return 2;
@@ -25,6 +27,10 @@ void putFloat(uint8_t *out, float value) {
     uint32_t bits;std::memcpy(&bits,&value,4);
     for (unsigned i=0;i<4;++i) out[i]=uint8_t(bits>>(i*8));
 }
+void putI32(uint8_t *out, int32_t value) {
+    const uint32_t bits=uint32_t(value);
+    for (unsigned i=0;i<4;++i) out[i]=uint8_t(bits>>(i*8));
+}
 void putAngle(uint8_t *out, float value) {
     // Firmware trunc.s then sext16. Nonfinite inputs have no valid wire angle.
     int32_t v=0;
@@ -155,6 +161,13 @@ size_t buildReadResponse(const CommandEvent &r,const Telemetry &t,uint8_t *out,s
     case 0x66:putAngle(data,t.roll_deg);break;
     case 0x67:putAngle(data,t.pitch_deg);break;
     case 0x68:putAngle(data,t.yaw_deg);break;
+    case 0x0c:  // custom: per-wheel encoder ticks + raw position (4x int32 LE)
+        putI32(data,t.wheel11_ticks);putI32(data+4,t.wheel21_ticks);
+        putI32(data+8,t.wheel11_pos);putI32(data+12,t.wheel21_pos);break;
+    case 0x0d:  // custom: roll/pitch/yaw (3x float) + w11/w21 ticks (2x int32) + t_ms (uint32) = 24B
+        putFloat(data,t.roll_deg);putFloat(data+4,t.pitch_deg);putFloat(data+8,t.yaw_deg);
+        putI32(data+12,t.wheel11_ticks);putI32(data+16,t.wheel21_ticks);
+        putI32(data+20,int32_t(t.t_ms));break;
     default:return 0;
     }
     return buildFrame(0x12,r.reg,data,n,out,cap);
