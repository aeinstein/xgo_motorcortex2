 // Patch 0015: drive_i = integral of the speed error while driving (degrees of pitch target).
-struct BalanceState { Pid speed=speedPid(), pitch=pitchPid(); float drive_i=0; };
+struct BalanceState { Pid speed=speedPid(), pitch=pitchPid(); float drive_i=0; float vel_i=0; /* Patch 0031 */ };
+// Patch 0031: Geschwindigkeitsregler für den Rahmenweg (velocity_cmd.h, Stufe 3 von ARBEITSPLAN.md Punkt 4).
+// Soll-Nick = Original-P (0,11 bzw. 0,14 beim Halten) + Integral + Vorsteuerung atan(a_soll/g). Das Original-Integral
+// ist bei 100 gekappt (praktisch P, bleibende Abweichung unter Last: der Befehl wirkt wie eine Kraft); 0015 hielt
+// nur 30 % als Untergrenze. Hier ein echtes Integral mit Anti-Windup: es wächst nicht weiter, solange der Soll-Nick
+// in der Grenze (output_limit) steht und der Fehler weiter hinein zeigt, und nicht bei freeze (Hebeschutz greift).
+// Beim Halten (Stand, Positionshalten) klingt es mit kVelHoldTau ab, ohne Rahmenweg mit kVelOffTau (kein Sprung).
+// Die Vorsteuerung übernimmt Anfahren und Bremsen, das Integral nur Last (Steigung, Rollwiderstand): so wickelt
+// es beim Start nicht auf wie 0015 in der ersten Fassung (Pendeln mit ~5 s).
+struct VelocityControl {
+    bool on=false;          // Rahmenweg aktiv; aus = Originalweg (mit 0015) bitgleich
+    float accel=0;          // Soll-Beschleunigung mm/s² aus dem Generator
+    float ki=0.05f;         // ° Soll-Nick je (mm/s Fehler · s)
+    float i_max=4.0f;       // ° Betragsgrenze des Integrals
+    float ff_gain=1.0f;     // Anteil der Vorsteuerung atan(a/g)
+    float dt=0.004f;        // s seit dem letzten Regeltakt
+    bool freeze=false;      // Integral anhalten (Hebeschutz)
+};
+constexpr float kVelHoldTau=1.5f, kVelOffTau=0.3f;   // s
+constexpr float kGravityMmS2=9810.0f;
 // Patch 0015: the stock speed PI clamps its integral at 100 (ki 0.00073 -> at most 0.07 deg),
 // so it is effectively P only: pitch target = 0.11 x (target - speed), at most ~3.5 deg at full
 // command. A constant load (slight slope, rolling resistance) then stops the Rider although the
@@ -66,7 +85,8 @@ float updateBalance(BalanceState &, float forward_target,
                     float speed11, float speed21, float pitch_deg,
                     float pitch_bias, float pitch_rate_rad_s,
                     float filtered_height, bool holding, Wheels &,
-                    bool drive_integral=false);   // Patch 0015
+                    bool drive_integral=false,    // Patch 0015
+                    const VelocityControl* vc=nullptr);   // Patch 0031
