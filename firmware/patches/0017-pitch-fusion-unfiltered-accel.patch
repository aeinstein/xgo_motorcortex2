diff --git a/firmware/src/control/rider_leg_imu.cpp b/firmware/src/control/rider_leg_imu.cpp
--- a/firmware/src/control/rider_leg_imu.cpp
+++ b/firmware/src/control/rider_leg_imu.cpp
@@ -175,8 +175,16 @@
     s.last_us = now_us;
     const double pitch_weight = s.calibrated ? 1.0 / (double(std::fabs(s.gyro_pitch_filtered)) + 500.0) : 0.05;
     const double roll_weight = 1.0 / (double(std::fabs(s.gyro_roll_filtered)) + 200.0);
+    // Patch 0017: Die Fusion nimmt den Beschleunigungs-Nick dieser Probe statt des gefilterten. Der
+    // Vorfilter (0,97/0,03, ~0,1 s) hinkt in Bewegung nach, der Kreiselanteil gleicht das nicht aus:
+    // Nickbewegungen kamen ~6 % zu klein heraus (RiderPi 2026-11-17, liegend von Hand genickt, Bild
+    // gegen IMU 1,06, unabhängig von der Drehrate; im Stand stimmte der Winkel). Die Fusion selbst
+    // glättet mit ~1,5 s, das Rauschen bleibt praktisch gleich, der Gleichgewichtspunkt unverändert.
+    // Vor der Startkalibrierung (Gewicht 0,05) und eingefroren (0006) weiter der gefilterte Wert.
+    const double accel_pitch_fusion = s.calibrated && std::fabs(yaw_rate) <= 25.0f
+                                          ? double(accel_pitch) : double(s.accel_pitch_filtered);
     s.pitch_deg = float((double(s.pitch_deg) - double(s.gyro_pitch_filtered) * dt) * (1.0 - pitch_weight) +
-                        double(s.accel_pitch_filtered) * pitch_weight);
+                        accel_pitch_fusion * pitch_weight);
     s.pitch_rad = float(double(s.pitch_deg) / 57.3);
     s.roll_deg = float((double(s.roll_deg) - double(s.gyro_roll_filtered) * dt) * (1.0 - roll_weight) +
                        double(s.accel_roll_filtered) * roll_weight);
