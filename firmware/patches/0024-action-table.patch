 }
diff --git a/firmware/src/action_engine.h b/firmware/src/action_engine.h
index 917cc40..fe2cf0b 100644
--- a/firmware/src/action_engine.h
+++ b/firmware/src/action_engine.h
@@ -16,6 +16,26 @@ struct ActionEvents {
     bool has(ActionEvent flag) const { return (flags & uint32_t(flag))!=0; }
 };
 
+// Patch 0024: one stored action = a short list of motor set-points at given ticks (action_engine.cpp, kActions).
+constexpr int16_t kKeep=-1;                       // field of a step: leave this value as it is
+struct ActionStep {
+    uint16_t at;                                  // tick at which the step applies (0 = start of the action)
+    int16_t forward, turn, height, roll;          // command bytes 0..255 (128 = neutral) or kKeep
+    float roll_phase, height_phase;               // > 0 starts the wave, 0 stops it, kKeep leaves it
+};
+enum ActionFlag : uint8_t {
+    kActionFreeHeading=1,     // heading hold off during the action, restored 50 ms after its end (action 5)
+    kActionDefaultPeriods=2   // wave periods back to 128 at the start (action 6)
+};
+struct ActionDef {
+    uint8_t id;               // 1..236
+    uint16_t end;             // tick at which the action finishes and the commands return to neutral
+    uint8_t flags;
+    const ActionStep *steps;
+    uint8_t count;
+};
+const ActionDef *findAction(uint8_t id);          // nullptr = no such stored action
+
 // This state corresponds to the original command globals. The protocol and
 // controller may update it on the SAME owner task; ActionEngine is not threaded.
 struct ActionState {
@@ -59,10 +79,11 @@ public:
     ActionEvents takeEvents();
     uint16_t counter(uint8_t id) const { return id<255 ? counters_[id] : 0; }
     bool deferred() const { return restore_pending_; }
-    static bool supported(uint8_t id) { return id<=6 || id==255; }
+    static bool supported(uint8_t id) { return id==0 || id==255 || findAction(id)!=nullptr; }
 private:
     void resetCommands(uint32_t now_ms);
     void clearCounters();
+    void applySteps(const ActionDef &def, uint16_t step);
     void finish(uint8_t kind, uint32_t now_ms);
     void event(ActionEvent flag, uint8_t id=0);
     ActionState state_{};
