 namespace rider2 {
-namespace { constexpr uint8_t sequence[6]={1,2,3,4,5,6}; }
+namespace {
+constexpr uint8_t sequence[6]={1,2,3,4,5,6};
+
+// Patch 0024: the stored actions as a table instead of two switch blocks; actions 1..6 behave exactly as before.
+// An action is a purely MOTOR sequence: drive, turn, height, roll and the two waves. No LEDs, no sound: those
+// belong to the client. A new action = its steps plus one line in kActions; free numbers are 7..236
+// (237..241 and 253..255 are commands of register 0x3e, handled before the engine sees them).
+// Clients must know new numbers too: web/api.php (allows 1..6), xgonav/robot.py FW_ACTIONS (mirrors 3..5).
+// One step = one tick() = every 21st sensor loop (~63..81 ms on the RiderPi).
+constexpr ActionStep s1[]={{0,kKeep,kKeep,112,kKeep,10,kKeep}};              // roll wave at height 112
+constexpr ActionStep s2[]={{0,kKeep,kKeep,kKeep,kKeep,kKeep,10}};            // height wave
+constexpr ActionStep s3[]={{0,192,kKeep,kKeep,kKeep,kKeep,kKeep},            // forward ...
+                           {8,64,kKeep,kKeep,kKeep,kKeep,kKeep}};            // ... and back
+constexpr ActionStep s4[]={{0,176,208,kKeep,kKeep,kKeep,kKeep},              // zigzag forward ...
+                           {14,176,48,kKeep,kKeep,kKeep,kKeep},
+                           {28,96,208,kKeep,kKeep,kKeep,kKeep},              // ... and backward
+                           {44,96,48,kKeep,kKeep,kKeep,kKeep}};
+constexpr ActionStep s5[]={{0,kKeep,32,kKeep,kKeep,kKeep,10},                // turn one way with a height wave ...
+                           {46,kKeep,208,kKeep,kKeep,kKeep,kKeep}};          // ... and back
+constexpr ActionStep s6[]={{0,kKeep,kKeep,kKeep,kKeep,10,750}};              // roll and height wave
+template<std::size_t N> constexpr ActionDef def(uint8_t id,uint16_t end,uint8_t flags,const ActionStep (&steps)[N]) {
+    return ActionDef{id,end,flags,steps,uint8_t(N)};
+}
+constexpr ActionDef kActions[]={
+    def(1,50,0,s1), def(2,40,0,s2), def(3,20,0,s3), def(4,60,0,s4),
+    def(5,100,kActionFreeHeading,s5), def(6,80,kActionDefaultPeriods,s6),
+};
+}
+
+const ActionDef *findAction(uint8_t id) {
+    for(const auto &a:kActions) if(a.id==id) return &a;
+    return nullptr;
+}
+void ActionEngine::applySteps(const ActionDef &def, uint16_t step) {
+    for(uint8_t i=0;i<def.count;++i) {
+        const ActionStep &s=def.steps[i];
+        if(s.at!=step) continue;
+        if(s.forward!=kKeep) state_.command.forward=uint8_t(s.forward);
+        if(s.turn!=kKeep) state_.command.turn=uint8_t(s.turn);
+        if(s.height!=kKeep) state_.command.height=uint8_t(s.height);
+        if(s.roll!=kKeep) state_.command.roll=uint8_t(s.roll);
+        if(s.roll_phase>=0) state_.roll_phase=s.roll_phase;
+        if(s.height_phase>=0) state_.height_phase=s.height_phase;
+    }
+}
 
 ActionEngine::ActionEngine() = default;
 
