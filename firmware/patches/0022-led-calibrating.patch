     float forward_request=0,turn_request=0;
     LedFault fault=LedFault::None;
+    bool gyro_calibrating=false;   // patch 0022: boot calibration of the gyro still running
 };
+// Patch 0022: while the gyro boot calibration runs, a bright spot circles over the four LEDs (0 -> 1 -> 2 -> 3,
+// front left, rear left, rear right, front right) in the user colours, like a spinning top.
+// Factor n/256 for one LED: 255 where the spot is, fading softly to kCalibrationSpinMin a quarter turn away.
+constexpr std::uint32_t kCalibrationSpinPeriodMs = 400;   // one revolution
+constexpr std::uint8_t kCalibrationSpinMin = 30;
+std::uint8_t calibrationSpin(std::uint32_t now_ms,unsigned led);
