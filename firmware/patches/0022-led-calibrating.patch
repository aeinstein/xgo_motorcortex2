+std::uint8_t calibrationSpin(std::uint32_t now,unsigned led) {
+    // Angle between the spot and this LED in turns, -0.5 .. 0.5; the LEDs sit a quarter turn apart.
+    float d=float(now%kCalibrationSpinPeriodMs)/float(kCalibrationSpinPeriodMs)-0.25f*float(led&3u);
+    d-=std::floor(d+0.5f);
+    const float c=std::fabs(d)<0.25f?std::cos(d*6.2831853f):0.0f;
+    return std::uint8_t(float(kCalibrationSpinMin)+c*c*float(255-kCalibrationSpinMin)+0.5f);
